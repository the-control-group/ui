{
	"compilerOptions": {
		"baseUrl": "./src",
		"outDir": "lib",
		"target": "ES2020",
		"allowJs": true,
		"moduleResolution": "node",
		"experimentalDecorators": true,
		"jsx": "react-jsx",
		"declaration": true,
		"strict": true,
		"sourceMap": true,
		"allowSyntheticDefaultImports": true,
		"esModuleInterop": true
	},
	"include": ["./src/**/*"]
}
