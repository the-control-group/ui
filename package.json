{
	"name": "@the-control-group/ui",
	"version": "1.10.5",
	"description": "UI kit based on ReactJS for TCG projects",
	"main": "./lib/index.js",
	"type": "module",
	"exports": {
		".": "./lib/index.js"
	},
	"files": [
		"lib"
	],
	"sideEffects": [
		"**/*.css"
	],
	"scripts": {
	  "build": "vite build",
	  "vitedev": "vite",
	  "start": "tsc -b --watch && vite build --watch",
	  "transpile": "rm -rf lib/ && tsc",
	  "check:updates": "ncu",
	  "update:deps": "ncu -u",
	  "format": "prettier --list-different --write '**/*.{ts,tsx,js}'",
	  "test": "tsc --noEmit && eslint src && prettier '**/*.{ts,tsx,js}' --check && jest src",
	  "prepublishOnly": "npm run transpile"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/the-control-group/ui.git"
	},
	"author": "The Control Group",
	"license": "UNLICENSED",
	"bugs": {
		"url": "https://github.com/the-control-group/ui/issues"
	},
	"homepage": "https://github.com/the-control-group/ui#readme",
	"devDependencies": {
	  "@types/jest": "^29.5.14",
	  "@typescript-eslint/eslint-plugin": "^8.25.0",
	  "@typescript-eslint/parser": "^8.25.0",
	  "@vitejs/plugin-react": "^4.3.4",
	  "date-fns": "^4.1.0",
	  "eslint": "^9.21.0",
	  "eslint-config-prettier": "^10.0.2",
	  "eslint-plugin-prettier": "^5.2.3",
	  "eslint-plugin-react": "^7.37.4",
	  "eslint-plugin-react-hooks": "^5.1.0",
	  "glob": "^11.0.1",
	  "jest": "^29.7.0",
	  "npm-check-updates": "^17.1.15",
	  "prettier": "^3.5.2",
	  "ts-jest": "^29.2.6",
	  "typescript": "^5.7.3",
	  "vite": "^6.2.0",
	  "vite-plugin-dts": "^4.5.1",
	  "vite-plugin-lib-inject-css": "^2.2.1"
	},
	"peerDependencies": {
		"classnames": "^2.3.1",
		"react": ">=18",
		"react-dom": ">=18"
	}
}
